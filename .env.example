# Database — Supabase PARTAGÉE avec le site principal Affinité
# DATABASE_URL = pooler transaction (6543, ?pgbouncer=true&connection_limit=5).
# DIRECT_URL = connexion directe (5432) pour prisma migrate / db push.
DATABASE_URL="postgresql://postgres:password@localhost:5432/affinite?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/affinite?schema=public"

# Auth.js (NextAuth v5) — UTILISER LE MÊME SECRET que le site principal
# pour que les sessions soient partagées entre affinité.com et dashboard.affinité.com
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST=true

# UploadThing — mêmes clés que le site principal
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_SECRET="your-uploadthing-secret"

# K-Pay (paiements MoMo + Orange Money) — mêmes clés que le site principal
KPAY_BASE_URL="https://admin.kpay.site"
KPAY_API_KEY=""
KPAY_SECRET_KEY=""
KPAY_WEBHOOK_SECRET=""              # ⚠️ OBLIGATOIRE EN PROD
KPAY_CALLBACK_URL="http://localhost:3100/api/webhooks/kpay"

# Upstash Redis — mêmes credentials que le site principal (rate limit partagé)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_APP_NAME="Affinité"

# URLs externes vers le site principal Affinité (site public + espaces escort/client)
NEXT_PUBLIC_AFFINITE_URL="https://affinité.com"
# Si vide → utilise NEXT_PUBLIC_AFFINITE_URL + "/admin"
NEXT_PUBLIC_AFFINITE_ADMIN_URL=""
